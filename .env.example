# The Neon CLI (`neon link`) writes .env.local automatically with the three
# variables below (DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_BRANCH) — it
# rewrites that file on every `link` and `deploy`, so this example is
# documentation of the shape, not something to copy by hand for those two.
# Pooled (host contains "-pooler") — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct (host has no "-pooler") — used by drizzle-kit for schema push only
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example-123456.region.aws.neon.tech/neondb?sslmode=require"
# Shared secret required to create an account. Any long random string.
# This one is ours, not Neon's — the CLI will not write it; set it yourself.
SIGNUP_CODE="change-me"
